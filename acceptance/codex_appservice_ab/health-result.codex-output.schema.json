{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "overall_status",
    "summary",
    "coverage",
    "checks",
    "findings",
    "limitations",
    "mutations_performed"
  ],
  "properties": {
    "overall_status": {"type": "string", "enum": ["healthy", "degraded", "unknown"]},
    "summary": {"type": "string"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster_api", "nodes", "workloads", "gitops", "storage", "events"],
      "properties": {
        "cluster_api": {"type": "object", "additionalProperties": false, "required": ["status", "evidence"], "properties": {"status": {"type": "string", "enum": ["healthy", "degraded", "unknown", "not_checked"]}, "evidence": {"type": "string"}}},
        "nodes": {"type": "object", "additionalProperties": false, "required": ["status", "evidence"], "properties": {"status": {"type": "string", "enum": ["healthy", "degraded", "unknown", "not_checked"]}, "evidence": {"type": "string"}}},
        "workloads": {"type": "object", "additionalProperties": false, "required": ["status", "evidence"], "properties": {"status": {"type": "string", "enum": ["healthy", "degraded", "unknown", "not_checked"]}, "evidence": {"type": "string"}}},
        "gitops": {"type": "object", "additionalProperties": false, "required": ["status", "evidence"], "properties": {"status": {"type": "string", "enum": ["healthy", "degraded", "unknown", "not_checked"]}, "evidence": {"type": "string"}}},
        "storage": {"type": "object", "additionalProperties": false, "required": ["status", "evidence"], "properties": {"status": {"type": "string", "enum": ["healthy", "degraded", "unknown", "not_checked"]}, "evidence": {"type": "string"}}},
        "events": {"type": "object", "additionalProperties": false, "required": ["status", "evidence"], "properties": {"status": {"type": "string", "enum": ["healthy", "degraded", "unknown", "not_checked"]}, "evidence": {"type": "string"}}}
      }
    },
    "checks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["area", "status", "evidence"], "properties": {"area": {"type": "string"}, "status": {"type": "string", "enum": ["healthy", "degraded", "unknown", "not_checked"]}, "evidence": {"type": "string"}}}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "severity", "component", "summary", "evidence"], "properties": {"id": {"type": "string"}, "severity": {"type": "string", "enum": ["info", "warning", "high", "critical", "unknown"]}, "component": {"type": "string"}, "summary": {"type": "string"}, "evidence": {"type": "string"}}}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "mutations_performed": {"type": "boolean", "enum": [false]}
  }
}
