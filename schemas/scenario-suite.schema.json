{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vuoro:outctl:scenario-suite:v2",
  "title": "Provider-neutral scenario suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "suite_digest", "required_classes", "scenarios"],
  "properties": {
    "schema_version": {"const": "vuoro.outctl.scenario-suite/v2"},
    "suite_id": {"type": "string", "minLength": 1},
    "suite_digest": {"$ref": "#/$defs/digest"},
    "required_classes": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scenarios": {
      "type": "array", "minItems": 1, "maxItems": 128, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scenario_id", "scenario_class", "package", "fixture", "expected_facts"],
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1},
          "scenario_class": {"type": "string", "minLength": 1},
          "package": {"$ref": "#/$defs/file_binding"},
          "fixture": {"$ref": "#/$defs/file_binding"},
          "expected_facts": {"$ref": "#/$defs/file_binding"}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "file_binding": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}
    }
  }
}
