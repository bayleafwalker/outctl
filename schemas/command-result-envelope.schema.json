{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vuoro:outctl:command-result:v1alpha1",
  "title": "Vuoro outctl CommandResultEnvelope",
  "type": "object",
  "required": [
    "schema_version",
    "capture_ref",
    "capture_id",
    "bindings",
    "invocation",
    "command",
    "capture",
    "projection",
    "retrieval",
    "replicas",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "vuoro.outctl.result/v1alpha1"
    },
    "capture_ref": {
      "type": "string",
      "pattern": "^outctl://capture/"
    },
    "capture_id": {
      "type": "string",
      "minLength": 10
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "invocation": {
      "type": "object",
      "required": [
        "argv_display",
        "shell",
        "cwd",
        "host_id",
        "harness",
        "started_at"
      ],
      "properties": {
        "argv_display": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shell": {
          "type": "boolean"
        },
        "cwd": {
          "type": "string"
        },
        "host_id": {
          "type": "string"
        },
        "harness": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "command": {
      "type": "object",
      "required": [
        "started",
        "exit_code",
        "signal",
        "timed_out",
        "cancelled"
      ],
      "properties": {
        "started": {
          "type": "boolean"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "signal": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        },
        "cancelled": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "capture": {
      "type": "object",
      "required": [
        "status",
        "stdout_bytes",
        "stderr_bytes",
        "truncated",
        "manifest_sha256",
        "source"
      ],
      "properties": {
        "status": {
          "enum": [
            "COMPLETE",
            "CAPTURE_TRUNCATED",
            "CAPTURE_DEGRADED",
            "CAPTURE_FAILED",
            "RECOVERED_INCOMPLETE"
          ]
        },
        "stdout_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stderr_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stdout_lines": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "stderr_lines": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "event_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stdout_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "stderr_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "source": {
          "type": "object",
          "required": [
            "availability",
            "host_id",
            "path"
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "projection": {
      "type": "object",
      "required": [
        "projection_id",
        "policy_ref",
        "policy_digest",
        "mode",
        "bytes",
        "lines",
        "estimated_tokens",
        "lossy",
        "normalized",
        "deduplicated",
        "redacted",
        "sha256"
      ],
      "properties": {
        "projection_id": {
          "type": "string"
        },
        "policy_ref": {
          "type": "string"
        },
        "policy_digest": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "inline_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "token_estimator": {
          "type": "string"
        },
        "lossy": {
          "type": "boolean"
        },
        "normalized": {
          "type": "boolean"
        },
        "deduplicated": {
          "type": "boolean"
        },
        "redacted": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": true
    },
    "retrieval": {
      "type": "object",
      "required": [
        "available",
        "capabilities"
      ],
      "additionalProperties": true
    },
    "replicas": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "number",
          "string",
          "null"
        ]
      }
    }
  },
  "additionalProperties": true
}
