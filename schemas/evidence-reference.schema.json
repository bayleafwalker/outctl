{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vuoro:outctl:evidence-reference:v1",
  "title": "Bounded command evidence reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capture_ref", "operation", "projection_digest"],
  "properties": {
    "schema_version": {"const": "vuoro.outctl.evidence-reference/v1"},
    "capture_ref": {"type": "string", "pattern": "^outctl://capture/[a-f0-9]+/manifest/sha256/[a-f0-9]{64}$"},
    "operation": {"enum": ["projection", "inspect", "slice", "tail", "search", "search-many"]},
    "stream": {"type": ["string", "null"], "enum": ["stdout", "stderr", null]},
    "start": {"type": ["integer", "null"], "minimum": 0},
    "end": {"type": ["integer", "null"], "minimum": 0},
    "query_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "projection_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
