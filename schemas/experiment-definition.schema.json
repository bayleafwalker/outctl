{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vuoro:outctl:experiment-definition:v1",
  "title": "Homelab Analytics experiment definition",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    {"required": ["id", "baseline", "treatment", "metrics"]},
    {"required": ["experiment", "metrics"], "properties": {"experiment": {"$ref": "#/$defs/experiment"}}}
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "baseline": {"type": "string", "minLength": 1, "maxLength": 128},
    "treatment": {"type": "string", "minLength": 1, "maxLength": 128},
    "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "derived": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "outcome": {"type": "object"},
    "experiment": {"$ref": "#/$defs/experiment"}
  },
  "$defs": {
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "baseline", "treatment"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "baseline": {"type": "string", "minLength": 1, "maxLength": 128},
        "treatment": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  }
}
