{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vuoro:outctl:arm-matrix:v1",
  "title": "Sealed N-arm launch matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matrix_id", "matrix_digest", "arms", "contrasts"],
  "properties": {
    "schema_version": {"const": "vuoro.outctl.arm-matrix/v1"},
    "matrix_id": {"type": "string", "minLength": 1},
    "matrix_digest": {"$ref": "#/$defs/digest"},
    "arms": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["arm_id", "capture", "projection", "tool_surface"],
        "properties": {
          "arm_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,15}$"},
          "capture": {"type": "string", "minLength": 1},
          "projection": {"type": "string", "minLength": 1},
          "tool_surface": {"type": "string", "minLength": 1},
          "runner": {"type": "string", "minLength": 1}
        }
      }
    },
    "contrasts": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["contrast_id", "treatment_arm", "control_arm"],
        "properties": {
          "contrast_id": {"type": "string", "minLength": 1},
          "treatment_arm": {"type": "string", "minLength": 1},
          "control_arm": {"type": "string", "minLength": 1}
        }
      }
    },
    "held_constant": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
