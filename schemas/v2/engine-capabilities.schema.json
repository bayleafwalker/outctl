{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vuoro:outctl:engine-capabilities:v2",
  "title": "Outctl v2 engine capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine", "contract_versions", "features", "limits"],
  "properties": {
    "schema_version": {"const": "vuoro.outctl.engine-capabilities/v2"},
    "engine": {"type": "object", "additionalProperties": false, "required": ["id", "version", "platform"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "platform": {"type": "string", "minLength": 1}}},
    "contract_versions": {"type": "object", "additionalProperties": false, "required": ["run_request", "policy_snapshot", "run_result", "capture_manifest"], "properties": {"run_request": {"type": "array", "items": {"type": "string"}}, "policy_snapshot": {"type": "array", "items": {"type": "string"}}, "run_result": {"type": "array", "items": {"type": "string"}}, "capture_manifest": {"type": "array", "items": {"type": "string"}}}},
    "features": {"type": "object", "additionalProperties": false, "required": ["direct_argv", "explicit_shell", "stdin", "retrieval", "one_version_back_read"], "properties": {"direct_argv": {"const": true}, "explicit_shell": {"type": "boolean"}, "stdin": {"type": "boolean"}, "retrieval": {"type": "boolean"}, "one_version_back_read": {"const": true}, "pty": {"type": "boolean"}, "live_output": {"type": "boolean"}, "parent_shell_state": {"type": "boolean"}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_argv_items", "max_capture_bytes", "max_projection_bytes"], "properties": {"max_argv_items": {"type": "integer", "minimum": 1}, "max_capture_bytes": {"type": "integer", "minimum": 1}, "max_projection_bytes": {"type": "integer", "minimum": 1}}}
  }
}
