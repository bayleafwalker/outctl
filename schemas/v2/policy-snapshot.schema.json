{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vuoro:outctl:policy-snapshot:v2",
  "title": "Outctl v2 compiled policy snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "policy_ref", "policy_digest", "source", "cache", "session", "sinks", "capture", "command_scope", "execution_authority", "issued_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "vuoro.outctl.policy-snapshot/v2"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "policy_ref": {"type": "string", "minLength": 1},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "source": {"type": "object", "additionalProperties": false, "required": ["ref", "digest"], "properties": {"ref": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "cache": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "snapshot_id", "owner", "max_age_ms"],
      "properties": {
        "key": {"type": "string", "pattern": "^policy-cache://snapshot/[A-Za-z0-9._:-]+$"},
        "snapshot_id": {"type": "string", "minLength": 1},
        "owner": {"const": "python-policy-control"},
        "max_age_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}
      }
    },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "trust_domain", "commissioned"],
      "properties": {"session_id": {"type": "string", "minLength": 1}, "trust_domain": {"enum": ["trusted-local", "restricted", "export", "metadata-only"]}, "commissioned": {"type": "boolean"}},
      "allOf": [
        {"if": {"required": ["trust_domain"], "properties": {"trust_domain": {"const": "trusted-local"}}}, "then": {"properties": {"commissioned": {"const": true}}}}
      ]
    },
    "sinks": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "trust_domain", "disclosure", "redaction_required"],
        "properties": {"name": {"enum": ["model", "runner", "audit-receipt", "handoff"]}, "trust_domain": {"enum": ["trusted-local", "restricted", "export", "metadata-only"]}, "disclosure": {"enum": ["safe-unredacted", "sanitized", "metadata-only", "deny"]}, "redaction_required": {"type": "boolean"}, "classification_ceiling": {"enum": ["public", "internal", "confidential", "secret"]}},
        "allOf": [
          {"if": {"required": ["disclosure"], "properties": {"disclosure": {"const": "safe-unredacted"}}}, "then": {"properties": {"trust_domain": {"const": "trusted-local"}, "redaction_required": {"const": false}}}},
          {"if": {"required": ["disclosure"], "properties": {"disclosure": {"const": "sanitized"}}}, "then": {"properties": {"redaction_required": {"const": true}}}},
          {"if": {"required": ["trust_domain"], "properties": {"trust_domain": {"const": "metadata-only"}}}, "then": {"properties": {"disclosure": {"const": "metadata-only"}}}},
          {"if": {"required": ["trust_domain"], "properties": {"trust_domain": {"enum": ["restricted", "export"]}}}, "then": {"not": {"properties": {"disclosure": {"const": "safe-unredacted"}}}}}
        ]
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["commitment", "durability", "required"],
      "properties": {"commitment": {"enum": ["memory-only", "process-local", "host-persistent", "replicated"]}, "durability": {"enum": ["none", "host", "replica", "authoritative"]}, "required": {"type": "boolean"}},
      "allOf": [
        {"if": {"required": ["commitment"], "properties": {"commitment": {"enum": ["memory-only", "process-local"]}}}, "then": {"properties": {"durability": {"const": "none"}}}},
        {"if": {"required": ["commitment"], "properties": {"commitment": {"const": "host-persistent"}}}, "then": {"properties": {"durability": {"const": "host"}}}},
        {"if": {"required": ["commitment"], "properties": {"commitment": {"const": "replicated"}}}, "then": {"properties": {"durability": {"enum": ["replica", "authoritative"]}}}},
        {"if": {"required": ["required"], "properties": {"required": {"const": true}}}, "then": {"properties": {"commitment": {"enum": ["host-persistent", "replicated"]}, "durability": {"enum": ["host", "replica", "authoritative"]}}}}
      ]
    },
    "command_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["execution_modes", "explicit_shell_argv", "stdin_modes"],
      "properties": {
        "execution_modes": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "contains": {"const": "direct-argv"}, "items": {"enum": ["direct-argv", "explicit-shell"]}},
        "explicit_shell_argv": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}}},
        "stdin_modes": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "contains": {"const": "none"}, "items": {"enum": ["none", "inherited", "file-ref"]}}
      },
      "allOf": [
        {"if": {"properties": {"execution_modes": {"contains": {"const": "explicit-shell"}}}}, "then": {"properties": {"explicit_shell_argv": {"minItems": 1}}}, "else": {"properties": {"explicit_shell_argv": {"maxItems": 0}}}}
      ]
    },
    "execution_authority": {"type": "object", "additionalProperties": false, "required": ["owner", "can_authorize_execution", "can_retry"], "properties": {"owner": {"const": "external-runner"}, "can_authorize_execution": {"const": false}, "can_retry": {"const": false}}},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"session": {"properties": {"trust_domain": {"const": "trusted-local"}}}}}, "then": {"properties": {"capture": {"properties": {"commitment": {"enum": ["host-persistent", "replicated"]}, "required": {"const": true}}}}}},
    {"if": {"properties": {"session": {"properties": {"trust_domain": {"const": "restricted"}}}}}, "then": {"properties": {"sinks": {"items": {"properties": {"trust_domain": {"enum": ["restricted", "export", "metadata-only"]}}}}}}},
    {"if": {"properties": {"session": {"properties": {"trust_domain": {"const": "export"}}}}}, "then": {"properties": {"sinks": {"items": {"properties": {"trust_domain": {"enum": ["export", "metadata-only"]}}}}}}},
    {"if": {"properties": {"session": {"properties": {"trust_domain": {"const": "metadata-only"}}}}}, "then": {"properties": {"sinks": {"items": {"properties": {"trust_domain": {"const": "metadata-only"}}}}}}}
  ],
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
