{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vuoro:outctl:run-request:v2",
  "title": "Outctl v2 engine RunRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "command", "policy", "sink", "secret_channel", "bindings"],
  "properties": {
    "schema_version": {"const": "vuoro.outctl.run-request/v2"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "execution_mode", "shell_command", "cwd", "environment", "stdin", "requirements", "timeout_ms"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]+$"}},
        "execution_mode": {"enum": ["direct-argv", "explicit-shell"]},
        "shell_command": {"type": ["string", "null"], "minLength": 1, "maxLength": 65536, "pattern": "^[^\\u0000]+$"},
        "cwd": {"type": "string", "minLength": 1},
        "environment": {
          "type": "object", "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["inherited", "allowlist", "empty"]},
            "allowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          },
          "allOf": [
            {"if": {"required": ["mode"], "properties": {"mode": {"const": "allowlist"}}}, "then": {"required": ["allowlist"]}},
            {"if": {"required": ["mode"], "properties": {"mode": {"enum": ["inherited", "empty"]}}}, "then": {"properties": {"allowlist": {"maxItems": 0}}}}
          ]
        },
        "stdin": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "ref"],
          "properties": {
            "mode": {"enum": ["none", "inherited", "file-ref"]},
            "ref": {"type": ["string", "null"], "pattern": "^outctl://stdin/"}
          },
          "allOf": [
            {"if": {"required": ["mode"], "properties": {"mode": {"const": "file-ref"}}}, "then": {"properties": {"ref": {"type": "string"}}}},
            {"if": {"required": ["mode"], "properties": {"mode": {"enum": ["none", "inherited"]}}}, "then": {"properties": {"ref": {"const": null}}}}
          ]
        },
        "requirements": {
          "type": "object", "additionalProperties": false,
          "required": ["pty", "live_output", "parent_shell_state"],
          "properties": {
            "pty": {"type": "boolean"},
            "live_output": {"type": "boolean"},
            "parent_shell_state": {"type": "boolean"}
          }
        },
        "timeout_ms": {"type": ["integer", "null"], "minimum": 1}
      },
      "allOf": [
        {"if": {"required": ["execution_mode"], "properties": {"execution_mode": {"const": "direct-argv"}}}, "then": {"properties": {"shell_command": {"const": null}}}},
        {"if": {"required": ["execution_mode"], "properties": {"execution_mode": {"const": "explicit-shell"}}}, "then": {"required": ["shell_command"], "properties": {"shell_command": {"type": "string", "minLength": 1}}}}
      ]
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "ref", "digest"],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "sink": {
      "type": "object", "additionalProperties": false,
      "required": ["trust_domain", "target", "disclosure"],
      "properties": {
        "trust_domain": {"enum": ["trusted-local", "restricted", "export", "metadata-only"]},
        "target": {"enum": ["model", "runner", "audit-receipt", "handoff"]},
        "disclosure": {"enum": ["safe-unredacted", "sanitized", "metadata-only", "deny"]}
      },
      "allOf": [
        {"if": {"required": ["disclosure"], "properties": {"disclosure": {"const": "safe-unredacted"}}}, "then": {"properties": {"trust_domain": {"const": "trusted-local"}}}},
        {"if": {"required": ["trust_domain"], "properties": {"trust_domain": {"const": "metadata-only"}}}, "then": {"properties": {"disclosure": {"const": "metadata-only"}}}},
        {"if": {"required": ["target"], "properties": {"target": {"enum": ["audit-receipt", "handoff"]}}}, "then": {"not": {"properties": {"disclosure": {"const": "safe-unredacted"}}}}}
      ]
    },
    "secret_channel": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "refs"],
      "properties": {
        "mode": {"enum": ["none", "protected-opaque"]},
        "refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^secret://[A-Za-z0-9._:/-]+$"}}
      },
      "allOf": [
        {"if": {"required": ["mode"], "properties": {"mode": {"const": "none"}}}, "then": {"properties": {"refs": {"maxItems": 0}}}},
        {"if": {"required": ["mode"], "properties": {"mode": {"const": "protected-opaque"}}}, "then": {"properties": {"refs": {"minItems": 1}}}}
      ]
    },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["workspace_id", "session_id", "correlation_id"],
      "properties": {
        "workspace_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "correlation_id": {"type": "string", "minLength": 1},
        "action_id": {"type": ["integer", "null"], "minimum": 1},
        "attempt_id": {"type": ["string", "null"], "minLength": 1}
      }
    }
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
