{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vuoro:outctl:shadow-observation:v1",
  "title": "Raw-free shadow semantic observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_digest", "direct", "shadow", "equivalence", "overhead", "recovery", "observed_at"],
  "properties": {
    "schema_version": {"const": "vuoro.outctl.shadow-observation/v1"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "direct": {"$ref": "#/$defs/outcome"},
    "shadow": {"$ref": "#/$defs/outcome"},
    "equivalence": {
      "type": "object", "additionalProperties": false,
      "required": ["exit_match", "signal_match", "stdout_digest_match", "stderr_digest_match", "cwd_match", "semantically_equivalent"],
      "properties": {
        "exit_match": {"type": "boolean"}, "signal_match": {"type": "boolean"},
        "stdout_digest_match": {"type": "boolean"}, "stderr_digest_match": {"type": "boolean"},
        "cwd_match": {"type": "boolean"}, "semantically_equivalent": {"type": "boolean"}
      }
    },
    "overhead": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "paired_repetitions", "direct_median_ms", "shadow_median_ms", "wall_time_delta_ms", "wall_time_regression_ppm", "peak_rss_delta_bytes", "disk_bytes", "accepted"],
      "properties": {
        "policy_id": {"const": "paired-median-v1"},
        "paired_repetitions": {"type": "integer", "minimum": 5},
        "direct_median_ms": {"type": "integer", "minimum": 0},
        "shadow_median_ms": {"type": "integer", "minimum": 0},
        "wall_time_delta_ms": {"type": "integer"},
        "wall_time_regression_ppm": {"type": ["integer", "null"]},
        "peak_rss_delta_bytes": {"type": ["integer", "null"]},
        "disk_bytes": {"type": "integer", "minimum": 0},
        "accepted": {"type": "boolean"}
      }
    },
    "recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["forced_termination_tested", "recovered", "deadlock", "leaked_process"],
      "properties": {
        "forced_termination_tested": {"type": "boolean"}, "recovered": {"type": "boolean"},
        "deadlock": {"type": "boolean"}, "leaked_process": {"type": "boolean"}
      }
    },
    "observed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["exit_code", "signal", "stdout_sha256", "stderr_sha256", "cwd_sha256", "duration_ms"],
      "properties": {
        "exit_code": {"type": ["integer", "null"]}, "signal": {"type": ["integer", "null"]},
        "stdout_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "stderr_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "cwd_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "duration_ms": {"type": "integer", "minimum": 0}
      }
    }
  }
}
