{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vuoro:outctl:logical-command-request:v1",
  "title": "Runner-owned logical command request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "logical_command_id", "command_class", "logical_argv",
    "adapter_mode", "policy_ref", "policy_digest", "capture_required",
    "bindings", "identity", "timeout_ms"
  ],
  "properties": {
    "schema_version": {"const": "vuoro.outctl.logical-command-request/v1"},
    "logical_command_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "command_class": {"type": "string", "enum": ["kubernetes-read", "generic"]},
    "logical_argv": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "adapter_mode": {"type": "string", "enum": ["bypass", "shadow", "enforce"]},
    "policy_ref": {"type": "string", "minLength": 1},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "capture_required": {"type": "boolean"},
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "attempt_id", "session_id", "workspace_id", "correlation_id"],
      "properties": {
        "action_id": {"type": ["integer", "null"], "minimum": 1},
        "attempt_id": {"type": ["string", "null"], "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "workspace_id": {"type": "string", "minLength": 1},
        "correlation_id": {"type": "string", "minLength": 1}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["identity_source", "executable_sha256", "kubeconfig_sha256", "context_sha256", "api_server_sha256"],
      "properties": {
        "identity_source": {"const": "runner_injected"},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "kubeconfig_sha256": {"$ref": "#/$defs/sha256"},
        "context_sha256": {"$ref": "#/$defs/sha256"},
        "api_server_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "timeout_ms": {"type": ["integer", "null"], "minimum": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
